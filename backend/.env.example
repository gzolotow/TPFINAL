# Copiar este archivo como .env y completar. El .env NUNCA se sube al repo.

# Puerto del servidor
PORT=3000

# Conexión a PostgreSQL (local o Neon/Render en producción)
# Ejemplo local: postgresql://postgres:postgres@localhost:5432/mycollection
DATABASE_URL=

# true si la base exige SSL (Neon, Render, Railway). false en local.
DATABASE_SSL=false

# Secreto para firmar los JWT (un string largo y aleatorio)
JWT_SECRET=

# Duración del token (formato de jsonwebtoken: 7d, 12h, 30m...)
JWT_EXPIRES_IN=7d

# Origen del frontend permitido por CORS (en dev: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# development | production (en production la cookie se marca Secure)
NODE_ENV=development

# Solo para el seed de la cuenta demo
DEMO_EMAIL=
DEMO_PASSWORD=
